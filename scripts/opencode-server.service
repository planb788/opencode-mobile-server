[Unit]
Description=OpenCode API Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/opencode-mobile-server/opencode.env
ExecStart=/usr/local/bin/opencode serve --hostname 127.0.0.1 --port 4096
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
