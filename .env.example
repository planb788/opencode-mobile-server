# OpenCode server authentication. Use the same password when starting opencode serve.
OPENCODE_SERVER_PASSWORD=opencode

# The local OpenCode API that server.mjs proxies to.
OPENCODE_API_URL=http://127.0.0.1:4096

# Web gateway. Use 0.0.0.0 for Windows LAN access and 127.0.0.1 behind Nginx.
OPENCODE_WEB_HOST=0.0.0.0
OPENCODE_WEB_PORT=8787

# API key management (optional). When a key is saved/switched from the web
# page, server.mjs writes it to the OpenCode auth file and restarts the
# OpenCode service so the new key takes effect.
#
# The systemd service to restart on Linux. Set to "none" to disable.
OPENCODE_SERVICE_NAME=opencode-server.service
# Path to OpenCode's auth.json. Auto-detected per platform, change only if needed.
# OPENCODE_AUTH_FILE=
# Where server.mjs stores all saved keys (default: <project-root>/.auth-keys.json).
# OPENCODE_AUTH_KEYS_FILE=
